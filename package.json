    "onnxruntime-node": "1.30.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pdf-lib": "1.17.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.0.0"
}
